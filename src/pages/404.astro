---
import BaseHead from '../components/BaseHead.astro';
---

<html lang="nn">
	<head>
		<BaseHead title="Fann ikkje sida / Page not found" />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<main class="page">
			<h1>404</h1>
			<p>Fann ikkje sida. <a href="/">Gå til framsida</a>.</p>
			<p lang="en">Page not found. <a href="/en/">Go to the home page</a>.</p>
		</main>
	</body>
</html>

<style>
	.page {
		max-width: 60rem;
		margin: 0 auto;
		padding: clamp(3rem, 10vw, 7rem) clamp(1.25rem, 5vw, 3rem) 5rem;
	}

	h1 {
		margin-bottom: 1.5rem;
		font-size: clamp(3rem, 12vw, 7.5rem);
		font-weight: 720;
		letter-spacing: -0.045em;
		line-height: 0.92;
	}

	p + p {
		margin-top: 0.5rem;
		color: var(--muted);
	}
</style>
