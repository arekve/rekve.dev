---
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import Timeline from '../components/Timeline.astro';
import { employers, formatPeriod, formatYears, monthIndex, profile } from '../data/cv';

const now = new Date();
const years = Math.floor(
	(now.getUTCFullYear() * 12 + now.getUTCMonth() - monthIndex(profile.careerStart)) / 12,
);
const description = `${profile.name} is a fullstack developer in ${profile.location} with ${years} years of experience in TypeScript, React, Kotlin and .NET.`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={Astro.site} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{profile.name}, fullstack developer</title>
	</head>
	<body>
		<div class="page">
			<header class="hero">
				<h1>{profile.name}</h1>
				<p class="lede">
					Fullstack developer in {profile.location}. Senior consultant at Savvy, currently building
					DNB's new online bank.
				</p>
				<Timeline employers={employers} now={now} />
				<p class="about">
					I've been building web applications for {years} years, mostly in TypeScript and React, with
					Kotlin, C# or Node on the server and AWS or Azure underneath. I like owning a feature from the
					data model to the last bit of UI, and working closely with designers to get it right.
				</p>
			</header>

			<main>
				<section aria-labelledby="work">
					<h2 id="work">Work</h2>
					{
						employers.map((employer) => (
							<article class="employer" data-employer={employer.id}>
								<header>
									<h3>{employer.name}</h3>
									<p>{employer.role}</p>
									<p class="muted">{formatYears(employer)}</p>
								</header>
								<ul class="projects">
									{employer.projects.map((project) => (
										<li class="project" id={project.id}>
											<h4>{project.client}</h4>
											<p class="muted">
												{project.name}, {formatPeriod(project)}
											</p>
											<p class="description">{project.description}</p>
											<p class="stack muted">{project.stack.join(', ')}</p>
										</li>
									))}
								</ul>
							</article>
						))
					}
				</section>

				<section aria-labelledby="education">
					<h2 id="education">Education</h2>
					<p>{profile.education}</p>
				</section>
			</main>

			<footer aria-labelledby="contact">
				<h2 id="contact">Contact</h2>
				<p>
					Write to me at <a href={`mailto:${profile.email}`}>{profile.email}</a>, or find me on <a
						href={profile.github}>GitHub</a
					>.
				</p>
			</footer>
		</div>
	</body>
</html>

<style>
	.page {
		max-width: 64rem;
		margin: 0 auto;
		padding: clamp(2rem, 7vw, 5rem) clamp(1.25rem, 5vw, 3rem) 4rem;
	}

	h1 {
		font-size: clamp(3rem, 12vw, 7.5rem);
		font-weight: 780;
		letter-spacing: -0.045em;
		line-height: 0.92;
	}

	.lede {
		max-width: 30rem;
		margin-top: 1.25rem;
		font-size: clamp(1.1875rem, 2.4vw, 1.4375rem);
		line-height: 1.35;
	}

	.hero :global(.timeline) {
		margin-top: clamp(2.5rem, 6vw, 4rem);
	}

	.about {
		max-width: 36rem;
		margin-top: 2.5rem;
	}

	section,
	footer {
		margin-top: clamp(4rem, 9vw, 6rem);
	}

	h2 {
		margin-bottom: 1.75rem;
		font-size: 1.75rem;
		font-weight: 720;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	h3 {
		font-size: 1.3125rem;
		font-weight: 700;
		line-height: 1.3;
	}

	h4 {
		font-size: 1.0625rem;
		font-weight: 650;
	}

	.muted {
		color: var(--muted);
	}

	[data-employer='savvy'] {
		--c: var(--employer-savvy);
	}
	[data-employer='bouvet'] {
		--c: var(--employer-bouvet);
	}
	[data-employer='powerzeek'] {
		--c: var(--employer-powerzeek);
	}

	.employer {
		display: grid;
		grid-template-columns: 13rem minmax(0, 36rem);
		gap: 1rem 3rem;
	}

	.employer + .employer {
		margin-top: 3.5rem;
	}

	.employer > header {
		align-self: start;
		border-top: 3px solid var(--c);
		padding-top: 0.6rem;
	}

	.projects {
		display: grid;
		gap: 2rem;
		padding: 0;
		list-style: none;
	}

	.project {
		scroll-margin-top: 2rem;
	}

	.project:target {
		animation: arrive 1.8s ease-out;
	}

	@keyframes arrive {
		from {
			background: color-mix(in oklab, var(--c) 22%, transparent);
			box-shadow: 0 0 0 0.75rem color-mix(in oklab, var(--c) 22%, transparent);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project:target {
			animation: none;
		}
	}

	.description {
		margin-top: 0.5rem;
	}

	.stack {
		margin-top: 0.5rem;
		font-size: 0.9375rem;
	}

	@media (width < 48rem) {
		.employer {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
		}
	}
</style>
