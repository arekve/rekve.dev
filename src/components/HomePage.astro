---
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import { employers, formatYears, monthIndex, profile } from '../data/cv';
import { type Locale, locales, ui } from '../i18n/ui';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const otherLang = lang === 'nn' ? 'en' : 'nn';

const now = new Date();
const years = Math.floor(
	(now.getUTCFullYear() * 12 + now.getUTCMonth() - monthIndex(profile.careerStart)) / 12,
);
---

<html lang={t.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={getAbsoluteLocaleUrl(lang)} />
		{locales.map((locale) => <link rel="alternate" hreflang={ui[locale].htmlLang} href={getAbsoluteLocaleUrl(locale)} />)}
		<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en')} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={t.description(years)} />
		<meta name="theme-color" content="#152027" />
		<title>{profile.name}, {t.title}</title>
	</head>
	<body>
		<div class="page">
			<a class="language" href={getRelativeLocaleUrl(otherLang)} hreflang={ui[otherLang].htmlLang} lang={ui[otherLang].htmlLang}>
				{ui[otherLang].languageName}
			</a>

			<header class="hero">
				<h1>{profile.name}</h1>
				<p class="lede">{t.lede}</p>
				<p class="about">{t.about(years)}</p>
			</header>

			<main>
				<section aria-labelledby="work">
					<h2 id="work">{t.work}</h2>
					{
						employers.map((employer) => (
							<article class="employer">
								<header>
									<h3>{employer.name}</h3>
									<p class="muted">
										{employer.role[lang]}, <span class="years">{formatYears(employer, t.now)}</span>
									</p>
								</header>
								<ul class="projects">
									{employer.projects.map((project) => (
										<li>
											<h4>{project.client}</h4>
											<p class="muted">
												{project.name[lang]}, <span class="years">{formatYears(project, t.now)}</span>
											</p>
											<p class="description">{project.description[lang]}</p>
										</li>
									))}
								</ul>
							</article>
						))
					}
				</section>

				<section aria-labelledby="education">
					<h2 id="education">{t.education}</h2>
					<p>{profile.education[lang]}</p>
				</section>
			</main>

			<footer aria-labelledby="contact">
				<h2 id="contact">{t.contact}</h2>
				<p>
					{t.writeTo} <a href={`mailto:${profile.email}`}>{profile.email}</a>, {t.findMeOn} <a
						href={profile.github}>GitHub</a
					>.
				</p>
			</footer>
		</div>
	</body>
</html>

<style>
	.page {
		position: relative;
		max-width: 60rem;
		margin: 0 auto;
		padding: clamp(3rem, 10vw, 7rem) clamp(1.25rem, 5vw, 3rem) 5rem;
	}

	.language {
		position: absolute;
		top: clamp(1rem, 3vw, 2rem);
		right: clamp(1.25rem, 5vw, 3rem);
		color: var(--muted);
		font-size: 0.9375rem;
	}

	.language:hover {
		color: var(--fg);
	}

	h1 {
		font-size: clamp(3rem, 12vw, 7.5rem);
		font-weight: 720;
		letter-spacing: -0.045em;
		line-height: 0.92;
	}

	.lede {
		max-width: 30rem;
		margin-top: 1.5rem;
		font-size: clamp(1.1875rem, 2.4vw, 1.4375rem);
		line-height: 1.35;
	}

	.about {
		max-width: 36rem;
		margin-top: 1.5rem;
		color: var(--muted);
	}

	section,
	footer {
		margin-top: clamp(4.5rem, 10vw, 7rem);
	}

	h2 {
		margin-bottom: 2rem;
		font-size: 1.75rem;
		font-weight: 680;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	h3 {
		font-size: 1.3125rem;
		font-weight: 650;
		line-height: 1.3;
	}

	h4 {
		font-size: 1.0625rem;
		font-weight: 620;
	}

	.muted {
		color: var(--muted);
	}

	.years {
		white-space: nowrap;
	}

	.employer {
		display: grid;
		grid-template-columns: 13rem minmax(0, 34rem);
		gap: 1rem 3rem;
		border-top: 1px solid var(--rule);
		padding-top: 1.25rem;
	}

	.employer + .employer {
		margin-top: 3rem;
	}

	.projects {
		display: grid;
		gap: 1.5rem;
		padding: 0;
		list-style: none;
	}

	.description {
		margin-top: 0.25rem;
	}

	@media (width < 48rem) {
		.employer {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.25rem;
		}
	}
</style>
